{
  "folders": [
    {
      "path": "backend"
    },
    {
      "path": "back-end-homework"
    },
    {
      "path": "database"
    },
    {
      "path": "node-app-test"
    },
    {
      "path": "front-end"
    },
    {
      "path": "front-end-homework"
    },
    {
      "path": "front_end_test"
    }
  ],
  "settings": {
    "java.gradle.buildServer.enabled": "off",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.server.launchMode": "Standard",
    "java.project.resourceFilters": [
      "node_modules",
      "\\.git",
      "\\.local",
      "\\.gradle"
    ],
    "java.import.exclusions": [
      "**/node_modules/**",
      "**/.metadata/**",
      "**/archetype-resources/**",
      "**/META-INF/maven/**",
      "**/.local/**",
      "**/.gradle/**",
      "**/build/**"
    ],
    "files.watcherExclude": {
      "**/.gradle/**": true,
      "**/build/**": true,
      "**/.local/**": true
    },
    "search.exclude": {
      "**/.gradle/**": true,
      "**/build/**": true,
      "**/.local/**": true
    },
    "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
    "liveServer.settings.multiRootWorkspaceName": "front-end"
  }
}
