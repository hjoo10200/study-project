<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <settings> <!--mybatis쓸 때 필수 설정-->
        <setting name="mapUnderscoreToCamelCase" value="true"/> 
        <setting name="jdbcTypeForNull" value="NULL"/>
    </settings>
    <typeAliases>
        <typeAlias alias="board" type="com.mycompany.demo.database.entity.Board"/>
        <typeAlias alias="member" type="com.mycompany.demo.database.entity.Member"/>
        <typeAlias alias="orderItem" type="com.mycompany.demo.database.entity.OrderItem"/>
        <typeAlias alias="orders" type="com.mycompany.demo.database.entity.Orders"/>
        <typeAlias alias="product" type="com.mycompany.demo.database.entity.Product"/>
        <typeAlias alias="seller" type="com.mycompany.demo.database.entity.Seller"/>
    </typeAliases>
</configuration>
