<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mycompany.demo.database.dao.OrdersDao">

    <insert id="insert" parameterType="orders" useGeneratedKeys="true" keyProperty="orderId" keyColumn="order_id">
        INSERT INTO orders (member_id, ordered_at)
        VALUES (#{memberId}, COALESCE(#{orderedAt}, CURRENT_TIMESTAMP))
    </insert>

    <select id="selectById" resultType="orders">
        SELECT order_id, member_id, ordered_at
        FROM orders
        WHERE order_id = #{orderId}
    </select>

    <!-- where keys: orderId, memberId -->
    <sql id="searchCondition">
        <where>
            <if test="where != null">
                <if test="where.orderId != null">
                    AND order_id = #{where.orderId}
                </if>
                <if test="where.memberId != null and where.memberId != ''">
                    AND member_id LIKE CONCAT('%', #{where.memberId}, '%')
                </if>
            </if>
        </where>
    </sql>

    <select id="selectCount" resultType="_int">
        SELECT COUNT(*)
        FROM orders
        <include refid="searchCondition" />
    </select>

    <select id="selectPage" resultType="orders">
        SELECT order_id, member_id, ordered_at
        FROM orders
        <include refid="searchCondition" />
        ORDER BY order_id DESC
        LIMIT #{pager.rowsPerPage} OFFSET #{pager.startRowIndex}
    </select>

    <update id="update" parameterType="orders">
        UPDATE orders
        SET member_id = #{memberId}
        WHERE order_id = #{orderId}
    </update>

    <delete id="deleteById">
        DELETE FROM orders
        WHERE order_id = #{orderId}
    </delete>

</mapper>
