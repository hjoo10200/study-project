<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mycompany.demo.database.dao.BoardDao">

    <insert id="insert" parameterType="board" useGeneratedKeys="true" keyProperty="boardId" keyColumn="board_id">
        INSERT INTO board (title, content, writer, writed_at, product_id)
        VALUES (#{title}, #{content}, #{writer}, CURRENT_TIMESTAMP, #{productId})
    </insert>

    <select id="selectById" resultType="board">
        SELECT board_id, title, content, writer, writed_at, product_id
        FROM board
        WHERE board_id = #{boardId}
    </select>

    <!-- where: title/content substring search; writer/productId exact match -->
    <sql id="searchCondition">
        <where>
            <if test="where != null">
                <if test="where.title != null and where.title != ''">
                    AND title LIKE CONCAT('%', #{where.title}, '%')
                </if>
                <if test="where.content != null and where.content != ''">
                    AND content LIKE CONCAT('%', #{where.content}, '%')
                </if>
                <if test="where.writer != null and where.writer != ''">
                    AND writer = #{where.writer}
                </if>
                <if test="where.productId != null">
                    AND product_id = #{where.productId}
                </if>
            </if>
        </where>
    </sql>

    <select id="selectCount" resultType="_int">
        SELECT COUNT(*) FROM board
        <include refid="searchCondition" />
    </select>

    <select id="selectPage" resultType="board">
        SELECT board_id, title, content, writer, writed_at, product_id
        FROM board
        <include refid="searchCondition" />
        ORDER BY board_id DESC
        LIMIT #{pager.rowsPerPage} OFFSET #{pager.startRowIndex}
    </select>

    <update id="update" parameterType="board">
        UPDATE board
        SET title = #{board.title},
            content = #{board.content},
            writer = #{board.writer},
            product_id = #{board.productId}
        WHERE board_id = #{board.boardId}
    </update>

    <delete id="deleteById">
        DELETE FROM board
        WHERE board_id = #{boardId} 
    </delete>

</mapper>
